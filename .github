name: Build DMG

on:
  workflow_dispatch:   # manual trigger

jobs:
  build:
    runs-on: macos-latest

    steps:

    - name: Clone Bitbucket Repo
      run: |
        git clone https://${{ secrets.BITBUCKET_USERNAME }}:${{ secrets.BITBUCKET_APP_PASSWORD }}@bitbucket.org/YOUR_ORG/YOUR_REPO.git

    - name: Setup Java
      uses: actions/setup-java@v3
      with:
        distribution: temurin
        java-version: 17

    - name: Build JAR
      run: |
        cd YOUR_REPO
        mvn clean package

    - name: Create DMG
      run: |
        cd YOUR_REPO

        jpackage \
          --input target/ \
          --name MyApp \
          --main-jar YOUR_JAR_NAME.jar \
          --type dmg \
          --dest output

    - name: Upload DMG
      uses: actions/upload-artifact@v3
      with:
        name: dmg-file
        path: YOUR_REPO/output/*.dmg
